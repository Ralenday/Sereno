<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17 (API 37) lo exige para conectarse a 10.0.2.2 (puente entre emuladores).
         En emuladores se concede con `adb shell pm grant` (ver EMULADORES.md). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application>
        <!-- Despierta la app cuando llega algo del otro dispositivo -->
        <service
            android:name=".EnlaceServicio"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:host="*" android:pathPrefix="/sereno" android:scheme="wear" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:host="*" android:pathPrefix="/sereno" android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
